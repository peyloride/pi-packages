{
  "name": "pi-extension-dashboard",
  "version": "1.0.0",
  "description": "Dashboard for pi extension packages with trending, popularity, and freshness metrics",
  "type": "module",
  "scripts": {
    "dev": "nub watch backend/index.ts",
    "start": "nub backend/index.ts",
    "sync": "nub backend/sync.ts",
    "sync:full": "nub backend/sync.ts --full",
    "test": "DB_PATH=':memory:' nub --test 'backend/*.test.ts'",
    "test:coverage": "DB_PATH=':memory:' c8 --include='backend/**/*.ts' --exclude='backend/**/*.test.ts' nub --test 'backend/*.test.ts'"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "c8": "^11.0.0"
  }
}
